# Copiar para .env e preencher com os valores reais
# NUNCA commitar o .env no git

# Eclética MySQL
# O pessoal da Eclética confirmou que o host é o IP deste PC
# Use o IP local da sua máquina na rede da loja, ou "localhost" se rodar daqui
ECLETICA_HOST=localhost
ECLETICA_PORT=3306
ECLETICA_USER=admin
ECLETICA_PASSWORD=admin
ECLETICA_DB=02060007ecleticaloja_bi

# Supabase Greenjoy
# Project Settings > API > Project URL e service_role key
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dias de lookback no sync incremental
# Padrão 2 dias. Para carga inicial de 4 anos: SYNC_LOOKBACK_DAYS=1500
SYNC_LOOKBACK_DAYS=2
